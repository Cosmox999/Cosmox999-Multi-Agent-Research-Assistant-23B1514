# Required API keys — copy this file to .env and fill in your values

# Tavily Search API key (get free key at https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Groq API key (get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: set to DEBUG for verbose output
LOG_LEVEL=INFO
